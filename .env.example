# =====================================================================
# DESARROLLO LOCAL  (cópialo a .env)
# Requiere Supabase local corriendo: `npx supabase start` (ver README). La API se
# conecta a SU Postgres (mismo que usan el frontend y Studio), no a un Postgres propio.
# =====================================================================
PROJECT_NAME=API Médicos por Venezuela
ENVIRONMENT=development

# Puerto/credenciales por defecto del CLI de Supabase (`supabase start`).
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# CORS: lista separada por comas, o "*" para permitir todos (solo en dev).
BACKEND_CORS_ORIGINS=*

# JWT del Supabase LOCAL: el CLI firma con claves asimétricas (ES256) por defecto, no
# con el secreto HS256 clásico -> se valida vía JWKS (SUPABASE_JWKS_URL). El secreto de
# abajo queda como fallback HS256; NO es el de producción — ese va en .env.production.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Videoconsulta (Jitsi) y resiliencia de la cola.
# JITSI_DOMAIN=meet.jit.si
# STALE_CONSULTATION_MINUTES=30

# =====================================================================
# PRODUCCIÓN (Supabase) — NO usar en local.
# Guarda estos valores en .env.supabase (ignorado por git) o en el gestor de
# secretos del hosting. DATABASE_URL tiene prioridad sobre las piezas POSTGRES_*.
# =====================================================================
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.PROJECT_REF
# POSTGRES_PASSWORD=...
# POSTGRES_SSLMODE=require
