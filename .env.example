# =====================================================================
# DESARROLLO LOCAL  (cópialo a .env)
# Requiere Supabase local corriendo: `npx supabase start` (ver README). La API se
# conecta a SU Postgres (mismo que usan el frontend y Studio), no a un Postgres propio.
# =====================================================================
PROJECT_NAME=API Médicos por Venezuela
ENVIRONMENT=development

# Puerto/credenciales por defecto del CLI de Supabase (`supabase start`).
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# CORS: lista separada por comas, o "*" para permitir todos (solo en dev).
BACKEND_CORS_ORIGINS=*

# --- Dirección cifrada E2E ---
# Emails (coma-separados) que pueden ver la dirección cifrada (ciphertext) de CUALQUIER paciente,
# además del médico tratante. La dirección se cifra en el navegador del paciente con la clave
# pública clínica (X25519 sealed box); la API NUNCA la descifra ni la loguea. Esta variable solo
# decide a QUIÉN se le sirve la ciphertext en GET /patients/{id}/address.
# Default: la responsable de protección de datos.
ADDRESS_VIEWER_EMAILS=orianaramirez@gmail.com

# --- Verificación de correo en el registro (código OTP de 6 dígitos) ---
# Secreto PROPIO para hashear los códigos (HMAC-SHA256) y firmar los tokens de verificación.
# En producción es OBLIGATORIO (32 bytes aleatorios, distinto de CONSULTATION_TOKEN_SECRET).
# EMAIL_VERIFICATION_SECRET=
# Validez del código (30-90 min) y del token ya verificado; intentos por código y reenvíos.
# EMAIL_VERIFICATION_CODE_TTL_MINUTES=60
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=15
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_RESEND_SECONDS=60
# EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
# Gate de los altas: con true, POST /doctors y POST /patients (con correo) exigen el token.
# EMAIL_VERIFICATION_REQUIRED=true
# Dev/e2e: el endpoint de envío devuelve el código en `debug_code`. Nunca en producción.
# EMAIL_VERIFICATION_DEBUG_CODE=false

# --- Cifrado de datos clínicos (AES-256-GCM) ---
# Sin definirla se usa una clave de desarrollo pública (la app se niega a arrancar con ella en
# producción). Un backup de prod restaurado en local trae los campos clínicos cifrados con la
# clave de prod: sin ella se ven en null, que es lo deseable para PII real en una máquina local.
# CLINICAL_DATA_ENCRYPTION_KEY=
# CLINICAL_DATA_ENCRYPTION_PREVIOUS_KEYS=

# JWT del Supabase LOCAL: el CLI firma con claves asimétricas (ES256) por defecto, no
# con el secreto HS256 clásico -> se valida vía JWKS (SUPABASE_JWKS_URL). El secreto de
# abajo queda como fallback HS256; NO es el de producción — ese va en .env.production.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Videoconsulta (Jitsi) y resiliencia de la cola.
# JITSI_DOMAIN=meet.jit.si
# STALE_CONSULTATION_MINUTES=30

# --- Kit (correo masivo de las encuestas de marketing) ---
# Clave de la API v4 de Kit (Settings -> Developer). Solo LEE las metricas de los envios para el
# embudo del panel (Marketing -> Graficos). Sin clave, el panel muestra solo las respuestas.
# Da acceso a la cuenta de Kit: no la subas a git ni la pegues en tickets o chats.
# KIT_API_KEY=
# Solo cuentan los envios de Kit desde este dia (hora de Venezuela).
# MARKETING_CAMPAIGNS_SINCE=2026-09-01

# --- Correo (Mailtrap) ---
# Sin MAILTRAP_API_TOKEN el envio queda DESHABILITADO: local y tests no mandan nada.
# MAILTRAP_API_TOKEN=
# Sandbox (Email Testing): con inbox definido, entrega ahi en vez de enviar de verdad.
# MAILTRAP_INBOX_ID=
#
# Buzones de OPERACION que reciben los avisos de alta (paciente nuevo en la cola, medico
# registrado aprobado o no). Lista separada por comas.
#
# ⚠️ VACIA por defecto y a proposito. Se define SOLO en .env.production: con las direcciones
# reales aqui, cualquier entorno de pruebas con token de Mailtrap le escribiria de verdad a
# esas personas en el primer registro de prueba. La contrapartida es que si se olvida en
# produccion NO sale ningun aviso interno (los correos al medico si salen: esos no dependen
# de esta variable). Verificalo tras desplegar.
# MAIL_INTERNAL_RECIPIENTS=info@medicosporvenezuela.org,otra@ejemplo.com
#
# Direccion PUBLICA de contacto: la que se le da a un medico para que mande su titulo, su
# licencia del SACS y su carta de articulo 8. Distinta de la de arriba (esa es "a quien
# avisamos" e incluye buzones personales; esta es "a donde escribe la gente"). Tiene valor por
# defecto porque si quedara vacia el correo mandaria al medico a una direccion no-reply.
# CONTACT_EMAIL=info@medicosporvenezuela.org
#
# Logotipo del banner de TODOS los correos (services/mail_layout.py). Es un PNG y no el SVG del
# sitio: Gmail, Outlook y Yahoo descartan un <img> que apunte a un SVG y saldria la imagen rota.
# El archivo lo genera `node scripts/build-logo-raster.mjs` en el repo del frontend y se sirve
# desde el sitio, asi que tiene que estar desplegado para que los correos lo muestren.
# Apunta a PRODUCCION por defecto incluso en local, a proposito: con FRONTEND_URL=localhost el
# logotipo llegaria roto a quien reciba un correo enviado desde una maquina de desarrollo.
# MAIL_LOGO_URL=https://medicosporvenezuela.org/brand/logo-white-email.png

# =====================================================================
# PRODUCCIÓN (Supabase) — NO usar en local.
# Guarda estos valores en .env.supabase (ignorado por git) o en el gestor de
# secretos del hosting. DATABASE_URL tiene prioridad sobre las piezas POSTGRES_*.
# =====================================================================
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.PROJECT_REF
# POSTGRES_PASSWORD=...
# POSTGRES_SSLMODE=require
