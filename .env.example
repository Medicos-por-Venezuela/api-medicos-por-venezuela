# =====================================================================
# DESARROLLO LOCAL  (cópialo a .env)
# La API se conecta al Postgres local del docker-compose (servicio "db").
# =====================================================================
PROJECT_NAME=API Médicos por Venezuela
ENVIRONMENT=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medicos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdev
POSTGRES_SSLMODE=prefer

# CORS: lista separada por comas, o "*" para permitir todos (solo en dev).
BACKEND_CORS_ORIGINS=*

# Autenticación: secreto JWT del proyecto Supabase (Settings -> API -> JWT Secret).
# OBLIGATORIO en producción. El valor por defecto del código es solo para dev/tests.
# SUPABASE_JWT_SECRET=super-secreto-de-supabase
# SUPABASE_JWT_AUDIENCE=authenticated

# Videoconsulta (Jitsi) y resiliencia de la cola.
# JITSI_DOMAIN=meet.jit.si
# STALE_CONSULTATION_MINUTES=30

# =====================================================================
# PRODUCCIÓN (Supabase) — NO usar en local.
# Guarda estos valores en .env.supabase (ignorado por git) o en el gestor de
# secretos del hosting. DATABASE_URL tiene prioridad sobre las piezas POSTGRES_*.
# =====================================================================
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.PROJECT_REF
# POSTGRES_PASSWORD=...
# POSTGRES_SSLMODE=require
