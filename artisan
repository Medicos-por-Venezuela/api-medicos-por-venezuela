#!/usr/bin/env python
"""artisan — CLI del proyecto (estilo Laravel). Punto de entrada corto en la raíz.

Comandos:
  make:migration "<desc>"   Crea una migración en db/migrations/ y muestra la ruta a editar.
  migrate                   Aplica las migraciones pendientes.
  migrate:status            Lista las migraciones: aplicadas vs pendientes.

Uso:
  python artisan migrate
  ./artisan migrate                # Unix/macOS (el archivo ya es ejecutable)
  python artisan make:migration "add phone to doctors"

Se auto-ejecuta con el intérprete del venv (.venv), así que no necesitas activarlo.
Los comandos de migración delegan en scripts/migrate.py (asyncpg + config de la app).
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

# Re-ejecuta con el python del venv si el actual no lo es, para que `python artisan`
# funcione aunque el entorno no esté activado (el venv tiene asyncpg y la config).
# subprocess (no os.execv): maneja bien rutas con espacios en Windows.
_VENV_PY = ROOT / (".venv/Scripts/python.exe" if os.name == "nt" else ".venv/bin/python")
if _VENV_PY.exists() and Path(sys.executable).resolve() != _VENV_PY.resolve():
    import subprocess

    sys.exit(subprocess.call([str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]]))

sys.path.insert(0, str(ROOT / "scripts"))
import migrate  # noqa: E402  (scripts/migrate.py)

# Comando estilo Laravel -> subcomando de scripts/migrate.py.
_MIGRATE_ALIASES = {
    "make:migration": "new",
    "migrate": "up",
    "migrate:status": "status",
}


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "-h", "--help", "list"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in _MIGRATE_ALIASES:
        return migrate.main([_MIGRATE_ALIASES[cmd], *rest])
    print(f"artisan: comando desconocido '{cmd}'. Prueba: python artisan help", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
